		reg = <0x00 0x1000c000 0x00 0xe00>;
	};

	fhctl-new@1000ce00 {
		compatible = "mediatek,mt6877-fhctl";
		reg = <0x00 0x1000ce00 0x00 0x200 0x00 0x1000c000 0x00 0xe00 0x00 0x13fa0e00 0x00 0x200 0x00 0x13fa0000 0x00 0xe00 0x00 0x190f3e00 0x00 0x200 0x00 0x190f3000 0x00 0xe00>;

		map0 {
			domain = "top";
			method = "fhctl-mcupm";

			armpll_ll {
				fh-id = <0x00>;
				pll-id = <0x00>;
				perms = <0x18>;
			};

			armpll_bl0 {
				fh-id = <0x01>;
				pll-id = <0x01>;
				perms = <0x18>;
			};

			ccipll {
				fh-id = <0x03>;
				pll-id = <0x03>;
				perms = <0x18>;
			};

			emipll {
				fh-id = <0x05>;
				pll-id = <0x05>;
			};

			mpll {
				fh-id = <0x06>;
				pll-id = <0x06>;
			};

			mmpll {
				fh-id = <0x07>;
				pll-id = <0x07>;
			};

			mainpll {
				fh-id = <0x08>;
				pll-id = <0x08>;
			};

			msdcpll {
				fh-id = <0x09>;
				pll-id = <0x09>;
			};

			adsppll {
				fh-id = <0x0a>;
				pll-id = <0x0a>;
			};

			tvdpll {
				fh-id = <0x0c>;
				pll-id = <0x0c>;
			};
		};

		map1 {
			domain = "gpu";
			method = "fhctl-ap";

			mfgpll1 {
				fh-id = <0x00>;
				pll-id = <0x0d>;
				perms = <0x03>;
			};

			mfgpll2 {
				fh-id = <0x01>;
				pll-id = <0x0e>;
				perms = <0x03>;
			};

			mfgpll3 {
				fh-id = <0x02>;
				pll-id = <0x0f>;
				perms = <0x03>;
			};

			mfgpll4 {
				fh-id = <0x03>;
				pll-id = <0x10>;
				perms = <0x03>;
			};
		};
	};

