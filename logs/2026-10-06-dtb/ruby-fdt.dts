		pinctrl-0 = <0x1bb>;
		pinctrl-1 = <0x1bc>;
		pinctrl-2 = <0x1bd>;
		pinctrl-3 = <0x1be>;
		pinctrl-4 = <0x1bf>;
		pinctrl-5 = <0x1c0>;
		pinctrl-6 = <0x1c1>;
		pinctrl-7 = <0x1c2>;
		pinctrl-8 = <0x1c3>;
