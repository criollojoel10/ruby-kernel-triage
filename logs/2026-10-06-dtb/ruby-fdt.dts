	cpus {
		#address-cells = <0x01>;
		#size-cells = <0x00>;

		cpu0: cpu@000 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x00>;
			enable-method = "psci";
			clock-frequency = <0x77359400>;
			operating-points-v2 = <0x02>;
			dynamic-power-coefficient = <0x55>;
			capacity-dmips-mhz = <0x111>;
			cpu-idle-states = <0x03 0x04 0x05 0x06>;
