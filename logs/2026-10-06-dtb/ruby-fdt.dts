		subpmic_mtk: mt6360_pmu: mt6360@34 {
			compatible = "mediatek,mt6360";
			reg = <0x34>;
			wakeup-source;
			interrupt-parent = <0x49>;
			interrupts = <0x04 0x08>;
			interrupt-names = "IRQB";
			interrupt-controller;
			#interrupt-cells = <0x01>;
			status = "okay";
			phandle = <0xcd>;

			mt6360_chg: charger {
				compatible = "mediatek,mt6360-chg";
				richtek,vinovp-microvolt = <0xdd40a0>;
				io-channels = <0xa7 0x00 0xa7 0x01 0xa7 0x03 0xa7 0x04 0xa7 0x05 0xa7 0x06 0xa7 0x08 0xa7 0x0a>;
				io-channel-names = "USBID", "VBUSDIV5", "VSYS", "VBAT", "IBUS", "IBAT", "TEMP_JC", "TS";
				bootmode = <0x53>;
				ichg = <0x1e8480>;
				aicr = <0x7a120>;
				mivr = <0x432380>;
				cv = <0x426030>;
				ieoc = <0x249f0>;
				safety_timer = <0x0c>;
				ircmp_resistor = <0x61a8>;
				ircmp_vclamp = <0x7d00>;
				en_te = <0x01>;
				en_wdt = <0x01>;
				post_aicc = <0x01>;
				batoc_notify = <0x00>;
				bc12_sel = <0x00>;
				phys = <0xa8 0x03>;
				phy-names = "usb2-phy";
				phandle = <0xae>;

				otg_vbus: usb-otg-vbus {
					regulator-compatible = "usb-otg-vbus";
					regulator-name = "usb-otg-vbus";
					regulator-min-microvolt = <0x438528>;
					regulator-max-microvolt = <0x58e1e8>;
					regulator-min-microamp = <0x7a120>;
					regulator-max-microamp = <0x2dc6c0>;
					phandle = <0xaf>;
				};
			};

			mt6360_adc: adc {
				compatible = "mediatek,mt6360-adc";
				#io-channel-cells = <0x01>;
				phandle = <0xa7>;
			};

			mt6360_led: led-controller {
				compatible = "mediatek,mt6360-led";
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				phandle = <0x19d>;

				flash@4 {
					reg = <0x04>;
					function = "flash";
					color = <0x00>;
					function-enumerator = <0x01>;
					led-max-microamp = <0x61a80>;
					flash-max-microamp = <0x124f80>;
					flash-max-timeout-us = <0x130b00>;
				};

				flash@5 {
					reg = <0x05>;
					function = "flash";
					color = <0x00>;
					function-enumerator = <0x02>;
					led-max-microamp = <0x61a80>;
					flash-max-microamp = <0x124f80>;
					flash-max-timeout-us = <0x130b00>;
				};
			};

			mt6360_ldo: mt6360_pmic: mt6360_regulator: regulator {
				compatible = "mediatek,mt6360-regulator";
				LDO_VIN3-supply = <0xa9>;
				pwr-off-seq = <0x4000002>;
				sdcard-det-en = <0x01>;
				sdcard-hlact = <0x01>;
				phandle = <0x19e>;

				mt6360_mdla_buck_reg: buck1 {
					regulator-name = "VMDLA";
					regulator-min-microvolt = <0x493e0>;
					regulator-max-microvolt = <0x13d620>;
					regulator-allowed-modes = <0x00 0x02 0x03>;
					regulator-always-on;
					phandle = <0x19f>;
				};

				mt6360_buck2: buck2 {
					regulator-name = "VDRAM1";
					regulator-min-microvolt = <0x493e0>;
					regulator-max-microvolt = <0x13d620>;
					regulator-allowed-modes = <0x00 0x02 0x03>;
					regulator-always-on;
					phandle = <0xa9>;
				};

				ldo6 {
					regulator-name = "VMDDR";
					regulator-min-microvolt = <0x7a120>;
					regulator-max-microvolt = <0x200b20>;
					regulator-allowed-modes = <0x00 0x02>;
					regulator-always-on;
				};

				ldo7 {
					regulator-name = "VDRAM2";
					regulator-min-microvolt = <0x7a120>;
					regulator-max-microvolt = <0x200b20>;
					regulator-allowed-modes = <0x00 0x02>;
					regulator-always-on;
				};

				mt_pmic_vfp_ldo_reg: ldo1 {
					regulator-name = "VFP";
					regulator-min-microvolt = <0x325aa0>;
					regulator-max-microvolt = <0x325aa0>;
					regulator-allowed-modes = <0x00 0x02>;
					phandle = <0x1a0>;
				};

				mt_pmic_vtp_ldo_reg: ldo2 {
					regulator-name = "vtp";
					regulator-min-microvolt = <0x325aa0>;
					regulator-max-microvolt = <0x325aa0>;
					regulator-allowed-modes = <0x00 0x02>;
					phandle = <0x1a1>;
					regulator-default-on = <0x01>;
					status = "okay";
				};

				mt_pmic_vmc_ldo_reg: ldo3 {
