/dts-v1/;

/ {
	model = "MT6877V/TTZA";
	compatible = "mediatek,mt6877", "mediatek,MT6877";
	interrupt-parent = <0x01>;
	#address-cells = <0x02>;
	#size-cells = <0x02>;

	bootprof {
		lk_logo_t = <0x2e9>;
		lk_t = <0x879>;
		pl_t = <0x8a4>;
	};

	md_attr_node {
		mediatek,md_product_name_model_id = <0xf0f0f0f>;
		mediatek,md_drdi_rf_set_idx = <0x13>;
		compatible = "mediatek,md_attr_node";
	};

	debug-kinfo {
		memory-region = <0x40020000>;
		compatible = "google,debug-kinfo";
	};

	firmware {

		android {
			mode = "normal";
			serialno = "vsqkkfojvsin6xor";
			hardware = "mt6877";
			compatible = "android,firmware";
			vbmeta.digest = "b0a69fd14ed6befc90417f355912727afddf465f3bc095c357c689889f020fce";
			vbmeta.size = "9344";
			vbmeta.hash_alg = "sha256";
		};
	};

