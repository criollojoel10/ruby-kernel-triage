	atf_logger {
		compatible = "mediatek,atf_logger";
	};

	utos {
		compatible = "microtrust,utos";
		microtrust,real-drv = <0x01>;
		interrupts = <0x00 0x75 0x01 0x00 0x76 0x01>;
	};

	utos_tester {
		compatible = "microtrust,tester-v1";
	};

	mtee_svp: mtee_svp {
		compatible = "medaitek,svp";
		phandle = <0xe2>;

		mtee: MTEE {
			compatible = "mediatek,mtk_svp_on_mtee_support";
			phandle = <0xe3>;
		};

		svp: SecureVideoPath {
			compatible = "mediatek,mtk_sec_video_path_support";
			phandle = <0xe4>;
		};
	};

	amms_control {
		compatible = "mediatek,amms";
		interrupts = <0x00 0x127 0x01>;
	};

	apmixedsys_clk: syscon@1000C000 {
		compatible = "mediatek,mt6877-apmixedsys", "syscon";
		reg = <0x00 0x1000c000 0x00 0x1000>;
		#clock-cells = <0x01>;
		phandle = <0x6a>;
	};

	scp_par_top_clk: syscon@10720000 {
		compatible = "mediatek,mt6877-scp_adsp", "syscon";
		reg = <0x00 0x10720000 0x00 0x1000>;
		#clock-cells = <0x01>;
		phandle = <0x6c>;
	};

	auxadc: auxadc@11001000 {
		compatible = "mediatek,mt6768-auxadc";
		reg = <0x00 0x11001000 0x00 0x1000>;
		interrupts = <0x00 0x60 0x01>;
		clocks = <0x3c 0x19>;
		clock-names = "main";
		#io-channel-cells = <0x01>;
		mediatek,cali-en-bit = <0x14>;
		mediatek,cali-ge-bit = <0x0a>;
		mediatek,cali-oe-bit = <0x00>;
		mediatek,cali-efuse-reg-offset = <0x1c4>;
		nvmem = <0x4a>;
		nvmem-names = "mtk_efuse";
		#interconnect-cells = <0x01>;
		phandle = <0x59>;

		adc_channel@ {
			compatible = "mediatek,adc_channel";
			mediatek,temperature0 = <0x00>;
			mediatek,temperature1 = <0x01>;
			mediatek,adc_fdd_rf_params_dynamic_custom_ch = <0x02>;
			status = "okay";
		};
	};

	btif: btif@1100c000 {
		compatible = "mediatek,btif";
		reg = <0x00 0x1100c000 0x00 0x100 0x00 0x10221200 0x00 0x80 0x00 0x10221280 0x00 0x80>;
		interrupts = <0x00 0xca 0x04 0x00 0xbe 0x04 0x00 0xbf 0x04>;
		clocks = <0x3c 0x14 0x3c 0x2d>;
		clock-names = "btifc", "apdmac";
		phandle = <0x34>;
	};

	audio_clk: syscon@11210000 {
		compatible = "mediatek,mt6877-audiosys", "syscon";
		reg = <0x00 0x11210000 0x00 0x1000>;
		pwr-regmap = <0x39>;
