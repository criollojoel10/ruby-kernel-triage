	ssusb: usb0@11201000 {
		compatible = "mediatek,mtu3";
		reg = <0x00 0x11201000 0x00 0x2e00 0x00 0x11203e00 0x00 0x100>;
		reg-names = "mac", "ippc";
		interrupts = <0x00 0x80 0x04>;
		interrupt-names = "ssusb_mac";
		phy-cells = <0x01>;
		phys = <0xa8 0x03 0xac 0x04>;
		clocks = <0x3c 0x24 0x6a 0x0c 0x3c 0x2d 0x3c 0x33>;
		clock-names = "sys_ck", "ref_ck", "dma_ck", "host_ck";
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;
		dr_mode = "otg";
		maximum-speed = "high-speed";
		mediatek,force-vbus;
		mediatek,clk-mgr;
		mediatek,spm-mgr;
		mediatek,usb3-drd;
		mediatek,noise-still-tr;
		usb-role-switch;
		status = "okay";
		phandle = <0x1aa>;

		port {

			mtu3_drd_switch: endpoint {
				remote-endpoint = <0xad>;
				phandle = <0xb0>;
			};
		};

