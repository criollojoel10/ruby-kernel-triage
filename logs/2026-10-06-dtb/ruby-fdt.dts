				};

				doe_dvfs_cl0: doe {
					phandle = <0xce>;
				};
			};

			cluster1 {

				core0 {
					cpu = <0x10>;
				};

				core1 {
					cpu = <0x11>;
				};

				doe_dvfs_cl1: doe {
					phandle = <0xcf>;
				};
			};
		};

		idle-states {
			entry-method = "arm,psci";

			cpuoff_l: cpuoff_l {
				compatible = "mediatek,idle-state";
				arm,psci-suspend-param = <0x10001>;
				local-timer-stop;
				entry-latency-us = <0x32>;
				exit-latency-us = <0x64>;
				min-residency-us = <0x640>;
				phandle = <0x03>;
			};

			cpuoff_b: cpuoff_b {
				compatible = "mediatek,idle-state";
				arm,psci-suspend-param = <0x10001>;
				local-timer-stop;
				entry-latency-us = <0x32>;
				exit-latency-us = <0x64>;
				min-residency-us = <0x578>;
				phandle = <0x08>;
			};

			clusteroff_l: clusteroff_l {
				compatible = "mediatek,idle-state";
				arm,psci-suspend-param = <0x1010001>;
				local-timer-stop;
				entry-latency-us = <0x64>;
				exit-latency-us = <0xfa>;
				min-residency-us = <0x834>;
				phandle = <0x04>;
			};

			clusteroff_b: clusteroff_b {
				compatible = "mediatek,idle-state";
				arm,psci-suspend-param = <0x1010001>;
				local-timer-stop;
				entry-latency-us = <0x64>;
				exit-latency-us = <0xfa>;
				min-residency-us = <0x76c>;
				phandle = <0x09>;
			};

			mcusysoff: mcusysoff {
				compatible = "mediatek,idle-state";
				arm,psci-suspend-param = <0x1010002>;
				local-timer-stop;
				entry-latency-us = <0x12c>;
				exit-latency-us = <0x4b0>;
				min-residency-us = <0xa28>;
				phandle = <0x05>;
			};

			s2idle: s2idle {
				compatible = "mediatek,idle-state";
				arm,psci-suspend-param = <0x1010100>;
				local-timer-stop;
				entry-latency-us = <0x1f4>;
				exit-latency-us = <0x578>;
				min-residency-us = <0xffffffff>;
				phandle = <0x06>;
			};
		};
	};

	disp_leds: disp_leds {
		compatible = "mediatek,disp-leds";
		phandle = <0xd0>;

		backlight {
			label = "lcd-backlight";
			max-brightness = <0xfff>;
			led-bits = <0x0c>;
			trans-bits = <0x0c>;
			default-state = "eighth";
			factory-max-brightness = <0x7ff>;
			factory-led-bits = <0x0b>;
			factory-trans-bits = <0x0b>;
		};
	};

	pwmleds {
		compatible = "mediatek,disp-pwm-leds";

		backlight {
			label = "lcd-backlight";
			pwms = <0x12 0x00 0x99d9>;
			max-brightness = <0xff>;
			led-bits = <0x08>;
			trans-bits = <0x0b>;
			pwm-names = "lcd-backlight";
			default-state = "on";
		};
	};

	i2c_leds {
		compatible = "mediatek,i2c-leds";

		backlight {
			label = "lcd-backlight";
			max-brightness = <0xff>;
			led-bits = <0x08>;
			trans-bits = <0x0b>;
			default-state = "on";
		};
	};

	mtk_lpm: mtk_lpm {
		compatible = "mediatek,mtk-lpm";
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;
		suspend-method = "s2idle";
		cpupm-method = "mcu";
		irq-remain = <0x13 0x14 0x15 0x16 0x17 0x18 0x19 0x1a 0x1b 0x1c 0x1d 0x1e 0x1f 0x20 0x21 0x22 0x23>;
		resource-ctrl = <0x24 0x25 0x26 0x27 0x28>;
		constraints = <0x29 0x2a 0x2b>;
		phandle = <0xd1>;

		cpupm_sysram: cpupm-sysram@0011b000 {
			compatible = "mediatek,cpupm-sysram";
			reg = <0x00 0x11b000 0x00 0x500>;
			phandle = <0xd2>;
		};

		lpm_sysram: lpm_sysram@0011b500 {
			compatible = "mediatek,lpm-sysram";
			reg = <0x00 0x11b500 0x00 0x300>;
			phandle = <0xd3>;
		};

		irq-remain-list {

			edge_keypad: edge_keypad {
				target = <0x2c>;
				value = <0x01 0x00 0x00 0x04>;
				phandle = <0x13>;
			};

			edge_mdwdt: edge_mdwdt {
				target = <0x2d>;
				value = <0x01 0x00 0x80000000 0x2000000>;
				phandle = <0x14>;
			};

			level_vpu_core0: level_vpu_core0 {
				target = <0x2e>;
				value = <0x00 0x00 0x00 0x00>;
