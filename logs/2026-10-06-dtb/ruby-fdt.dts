	irtx_pwm: irtx_pwm {
		compatible = "mediatek,irtx-pwm";
		pwm_ch = <0x00>;
		pwm_data_invert = <0x00>;
		phandle = <0x17f>;
		pinctrl-names = "irtx_gpio_led_default", "irtx_gpio_led_set";
		pinctrl-0 = <0x220>;
		pinctrl-1 = <0x221>;
		status = "okay";
	};

	odm: odm {
		compatible = "simple-bus";
		phandle = <0x180>;

		rt5133_eint: rt5133_eint {
			phandle = <0x181>;
		};

		rt5133_gpio1: rt5133-gpio1 {
			compatible = "regulator-fixed";
			regulator-name = "rt5133-gpio1";
			regulator-min-microvolt = <0x1b7740>;
			regulator-max-microvolt = <0x1b7740>;
			vin-supply = <0x9f>;
			enable-active-high;
			gpio = <0xa0 0x00 0x00>;
			phandle = <0x182>;
		};

		rt5133_gpio2: rt5133-gpio2 {
			compatible = "regulator-fixed";
			regulator-name = "rt5133-gpio2";
			regulator-min-microvolt = <0x1b7740>;
			regulator-max-microvolt = <0x1b7740>;
			vin-supply = <0x9f>;
			enable-active-high;
			gpio = <0xa0 0x01 0x00>;
			phandle = <0x183>;
		};

		rt5133_gpio3: rt5133-gpio3 {
			compatible = "regulator-fixed";
			regulator-name = "rt5133-gpio3";
			regulator-min-microvolt = <0x1b7740>;
			regulator-max-microvolt = <0x1b7740>;
			vin-supply = <0x9f>;
			enable-active-high;
			gpio = <0xa0 0x02 0x00>;
			phandle = <0x184>;
		};

		xiaomi_touch {
			compatible = "xiaomi-touch";
			status = "ok";
			touch,name = "xiaomi-touch";
			phandle = <0x222>;
		};

		led@0 {
			compatible = "mediatek,red";
			led_mode = <0x00>;
			data = <0x01>;
			pwm_config = <0x00 0x00 0x00 0x00 0x00>;
			phandle = <0x223>;
		};

		led@1 {
			compatible = "mediatek,green";
			led_mode = <0x00>;
			data = <0x01>;
			pwm_config = <0x00 0x00 0x00 0x00 0x00>;
			phandle = <0x224>;
		};

		led@2 {
			compatible = "mediatek,blue";
			led_mode = <0x00>;
			data = <0x01>;
			pwm_config = <0x00 0x00 0x00 0x00 0x00>;
			phandle = <0x225>;
		};

		led@3 {
			compatible = "mediatek,jogball-backlight";
			led_mode = <0x00>;
			data = <0x01>;
			pwm_config = <0x00 0x00 0x00 0x00 0x00>;
			phandle = <0x226>;
		};

		led@4 {
			compatible = "mediatek,keyboard-backlight";
			led_mode = <0x00>;
			data = <0x01>;
			pwm_config = <0x00 0x00 0x00 0x00 0x00>;
			phandle = <0x227>;
		};

		led@5 {
			compatible = "mediatek,button-backlight";
			led_mode = <0x00>;
			data = <0x01>;
			pwm_config = <0x00 0x00 0x00 0x00 0x00>;
			phandle = <0x228>;
		};

		led@6 {
			compatible = "mediatek,lcd-backlight";
			led_mode = <0x04>;
			data = <0x01>;
			led_config = <0x0c 0x0c>;
			phandle = <0x229>;
		};

		vibrator@0 {
			status = "disabled";
			compatible = "mediatek,vibrator";
			vib_timer = <0x19>;
			vib_limit = <0x09>;
			vib_vol = <0x09>;
			phandle = <0x22a>;
		};

		simtray {
			compatible = "xiaomi,simtray-status";
			status-gpio = <0x49 0xb0 0x00>;
		};

		thermal-message {
			board-sensor = "VIRTUAL-SENSOR";
			phandle = <0x231>;
		};
	};

	memory_ssmr_features: memory-ssmr-features {
		compatible = "mediatek,memory-ssmr-features";
		svp-region-based-size = <0x00 0x1a000000>;
		iris-recognition-size = <0x00 0x10000000>;
		2d_fr-size = <0x00 0x00>;
		wfd-size = <0x00 0x4000000>;
		prot-region-based-size = <0x00 0x8000000>;
		phandle = <0x185>;
