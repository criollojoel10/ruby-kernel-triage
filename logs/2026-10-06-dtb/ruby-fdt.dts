	sleep@10006000 {
		spmfw_version = "pcm_suspend_v3.3_20210511               ";
		compatible = "mediatek,sleep";
		reg = <0x00 0x10006000 0x00 0x1000>;
		interrupts = <0x00 0x10a 0x04 0x00 0x10b 0x04>;
	};

	toprgu: toprgu@10007000 {
		compatible = "mediatek,mt6877-wdt", "mediatek,mt6589-wdt", "mediatek,toprgu", "syscon", "simple-mfd";
		reg = <0x00 0x10007000 0x00 0x1000>;
		interrupts = <0x00 0x6d 0x04>;
		mediatek,rg_dfd_timeout = <0x1ffff>;
		#reset-cells = <0x01>;
		phandle = <0xf1>;

		reboot-mode {
			compatible = "syscon-reboot-mode";
			offset = <0x24>;
			mask = <0x0f>;
			mode-charger = <0x01>;
			mode-recovery = <0x02>;
			mode-bootloader = <0x03>;
			mode-dm-verity-dev-corrupt = <0x04>;
			mode-kpoc = <0x05>;
			mode-ddr-reserve = <0x06>;
			mode-meta = <0x07>;
			mode-rpmbpk = <0x08>;
		};
	};

	apxgpt@10008000 {
		compatible = "mediatek,apxgpt";
		reg = <0x00 0x10008000 0x00 0x1000>;
		mediatek,kick_off = <0xb4>;
